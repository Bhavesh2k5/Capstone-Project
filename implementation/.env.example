# Host path that contains the dataset folders (Anomaly-Detection-Dataset,
# cross camera data, real life voilence data, tinyvirat).
# This host folder is mounted read-only at /data inside containers.
CAPSTONE_DATA_ROOT_HOST=/mnt/datasets/capstone

# Path of the datasets as seen INSIDE the container (usually keep /data).
CAPSTONE_DATA_ROOT=/data

# auto | cuda | cpu
CAPSTONE_DEVICE=auto
